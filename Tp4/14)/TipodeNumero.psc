Algoritmo Tipo
	Escribir "Ingrese un numero entero: "
	Leer num1
	Escribir "1. El número ", num1 " es "
	Si num1>0 Entonces
		Escribir "Positivo."
	SiNo
		Escribir "Negativo."
	FinSi
	Escribir "2. El número ", num1 " es "
	Si num1 % 2 == 0 Entonces
		Escribir "Par."
	SiNo
		Escribir "Impar."
	FinSi
	Escribir "3. El número ", num1
	Si num1 % 5 == 0 Entonces
		Escribir " es Multiplo de 5"
	SiNo
		Escribir " no es Multiplo de 5."
	FinSi
FinAlgoritmo
