Algoritmo DatosDeUnLibro
	Escribir "Libros"
	Escribir "Título: "
	Leer Titu
	Escribir "Autor: "
	Leer Aut
	Escribir "Cantidad de Páginas: "
	Leer Can
	Escribir "Precio: "
	Leer Pre
	Pag = Pre/Can
	Escribir " "
	Escribir "Informe"
	Escribir "Título: ", Titu
	Escribir "Autor: ", Aut
	Escribir "Cantidad de Páginas: ", Can, " páginas."
	Escribir "Precio por página: $", Pag
FinAlgoritmo
