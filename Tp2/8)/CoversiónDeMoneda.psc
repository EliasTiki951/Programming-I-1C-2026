Algoritmo CoversiónDeMoneda
	Escribir "Conversión de Moneda"
	Escribir " "
	Escribir "Nombre de la persona: "
	Leer Nom
	Escribir "Cantidad de Pesos: "
	Leer Pes
	Escribir "Cotización del Dólar: "
	Leer Dola
	Doll = Pes/Dola
	Escribir " "
	Escribir "Informe"
	Escribir "Nombre de la Persona: ", Nom
	Escribir "Cantidad de Pesos: ", Pes
	Escribir "Cotización del Dólar: $", Dola
	Escribir "Puede comprar un total de $", Doll, " dolares."
FinAlgoritmo
