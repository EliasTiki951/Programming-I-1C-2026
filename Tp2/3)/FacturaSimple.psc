Algoritmo FacturaSimple
	Escribir "Nombre del producto: "
	Leer Nom
	Escribir "Precio Unitario: "
	Leer Pre
	Escribir "Cantidad: "
	Leer Can
	Total = Pre*Can
	Escribir " "
	Escribir "Nombre del producto: ", Nom
	Escribir "Precio: $", Pre
	Escribir "Cantidad: ", Can
	Escribir "Total a Pagar: $", Total
FinAlgoritmo
