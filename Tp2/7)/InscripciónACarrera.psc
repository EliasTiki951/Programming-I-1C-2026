Algoritmo InscripciónACarrera
	Escribir "Inscripción a Carrera"
	Escribir " "
	Escribir "Carrera a Inscricoubirse: "
	Leer Carr
	Escribir "Nombre del Estudiante: "
	Leer Nom
	Escribir "Edad: "
	Leer Edad
	Escribir "Cantidad de Materias: "
	Leer Can
	Escribir "Precio por Materia: "
	Leer Pre
	Cost = Can*Pre
	Escribir " "
	Escribir "Informe"
	Escribir "Carrera: ", Carr
	Escribir "Nombre del Estudiante: ", Nom
	Escribir "Edad: ", Edad
	Escribir "Cantidad de Materias: ", Can
	Escribir "Precio por Materia: $", Pre
	Escribir "El costo total de la Carrera: $", Cost
FinAlgoritmo
