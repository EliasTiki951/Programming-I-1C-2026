Algoritmo RegistroDeVehiculo
	Escribir "Registro de Vehículo"
	Escribir "Marca: "
	Leer Mar
	Escribir "Modelo: "
	Leer Mode
	Escribir "Año: "
	Leer Anio
	Escribir "Precio: "
	Leer Pre
	Des = Pre-(Pre*10)/100
	Escribir " "
	Escribir "Informe"
	Escribir "Marca: ", Mar
	Escribir "Modelo: ", Mode
	Escribir "Año: ", Anio
	Escribir "Precio: $", Pre
	Escribir "Con un 10% de descuento costaria $", Des
FinAlgoritmo
