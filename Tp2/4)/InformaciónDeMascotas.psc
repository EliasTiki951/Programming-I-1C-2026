Algoritmo InformaciónDeMascotas
	Escribir "Nombre de la Mascota: "
	Leer Mas
	Escribir "Tipo (perro, gato, etc.): "
	Leer Tipo
	Escribir "Edad: "
	Leer Edad
	Escribir "Peso (Kilos): "
	Leer Peso
	Escribir "Es Vacunado?"
	Escribir "1. Si"
	Escribir "2. No"
	Leer Vacu
	Escribir " "
	Escribir "El nombre de la mascota es ", Mas,"."
	Escribir "Tipo: ", Tipo, "."
	Escribir "Edad: ", Edad, " años."
	Escribir "Peso: ", Peso, " kilos."
	Si Vacu==1 Entonces
		Escribir "La mascota está vacunada."
	SiNo
		Escribir "La mascota no está vacunada."
	FinSi
FinAlgoritmo
